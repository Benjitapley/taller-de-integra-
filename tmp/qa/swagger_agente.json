  "findings": [
    {
      "id": "SW-01",
      "severity": "alta antes de produccion",
      "title": "Identidad no declarada como seguridad verificada",
      "refs": [
        "main/main.py:89",
        "main/main.py:365"
      ],
      "evidence": "No components.securitySchemes ni security global/operacion. roomies_id aparece como cookie opcional con default 1.",
      "fix": "Primero verificar sesion en servidor; despues declarar el esquema de seguridad de cookie y sus errores. Un candado Swagger no verifica identidad."
    },
    {
      "id": "SW-02",
      "severity": "media contrato",
      "title": "Errores reales no documentados",
      "refs": [
        "main/main.py:195",
        "main/main.py:301",
        "main/main.py:365",
        "auth_service/main.py:47"
      ],
      "evidence": "Solo 200/201 y 422 automatico; faltan 401,404,413,500 y 400/409 en registro.",
      "fix": "Declarar responses con descripciones y modelo de error para cada operacion."
    },
    {
      "id": "SW-03",
      "severity": "media contrato",
      "title": "422 usa dos formas y el esquema solo declara una",
      "refs": [
        "main/main.py:211",
        "main/main.py:99",
        "publicaciones_service/schemas.py"
      ],
      "evidence": "tipo=oficina produce detail:list; precio_min200>precio_max100 y mascota=talvez producen detail:str. HTTPValidationError declara detail:array.",
      "fix": "Estandarizar el error o declarar union de ambos modelos en responses[422]."
    },
    {
      "id": "SW-04",
      "severity": "media documentacion",
      "title": "Respuestas correctas sin estructura para 12 operaciones",
      "refs": [
        "main/main.py:279",
        "main/main.py:301",
        "main/main.py:330",
        "main/main.py:346",
        "main/main.py:430",
        "main/main.py:508",
        "auth_service/main.py:47"
      ],
      "evidence": "Solo crear/listar/buscar tienen response_model util. Detalle,cupos,editar,cerrar,mias,delete,perfil,auth,etc muestran schema {}.",
      "fix": "Modelos de respuesta minimos que reflejen el JSON real."
    },
    {
      "id": "SW-05",
      "severity": "baja documentacion",
      "title": "Metadatos y reglas de mascotas incompletos",
      "refs": [
        "main/main.py:66",
        "main/main.py:376",
        "main/main.py:377"
      ],
      "evidence": "Titulo FastAPI/version0.1.0; no tags auth/mias/delete/perfil. mascota admite string cualquiera en esquema, especies son string sin lista/ejemplo y faltan condiciones y limite de foto.",
      "fix": "Titulo y version del proyecto, tags coherentes, Literal si/no y descripciones/ejemplos del JSON de mascotas y formatos/tamano de imagen."
    },
    {
      "id": "SW-06",
      "severity": "baja documentacion",
      "title": "Formulario URL encoded aceptado pero no declarado",
      "refs": [
        "main/main.py:365",
        "main/README.md:65"
      ],
      "evidence": "requestBody solo multipart/form-data; las pruebas y README tambien usan application/x-www-form-urlencoded sin imagen.",
      "fix": "Declarar el contenido alternativo o explicar el alcance de la documentacion para consumidores."
    }
  ],

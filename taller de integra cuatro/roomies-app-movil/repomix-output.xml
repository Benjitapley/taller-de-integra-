import { useCallback, useState } from "react";
import { useFocusEffect } from "expo-router";
import { useAuth } from "@/hooks/useAuth";
import { consultarPerfilPropio, type ResultadoPerfilPropio } from "@/services/usuariosService";

export type EstadoPerfilPropio =
  | { tipo: "cargando" }
  | { tipo: "resultado"; resultado: ResultadoPerfilPropio };

export function usePerfilPropio() {
  const { usuarioActual, provisionPerfil, reintentarProvisionPerfil } = useAuth();
  const identidadId = usuarioActual?.identidad.id ?? null;
  const perfilPreparado = provisionPerfil?.exito === true;
  const [intento, setIntento] = useState(0);
  const [consulta, setConsulta] = useState<{
    identidadId: string | null;
    intento: number;
    estado: EstadoPerfilPropio;
  }>({ identidadId: null, intento: 0, estado: { tipo: "cargando" } });

  useFocusEffect(useCallback(() => {
    if (!identidadId || !perfilPreparado) return;
    let vigente = true;
    setConsulta({ identidadId, intento, estado: { tipo: "cargando" } });

    async function cargar() {
      let resultado: ResultadoPerfilPropio;
      try {
        resultado = await consultarPerfilPropio(undefined, identidadId ?? undefined);
      } catch {
        resultado = { exito: false, codigo: "red", error: "No pudimos consultar tu perfil. Inténtalo otra vez." };
      }
      if (vigente) setConsulta({ identidadId, intento, estado: { tipo: "resultado", resultado } });
    }

    void cargar();
    // Descarta resultados después de salir de Perfil, reintentar o cambiar de cuenta.
    return () => { vigente = false; };
  }, [identidadId, intento, perfilPreparado]));

  // Nunca mostrar el perfil anterior durante el render de un cambio de identidad.
  const estado: EstadoPerfilPropio = provisionPerfil && !provisionPerfil.exito
    ? { tipo: "resultado", resultado: provisionPerfil }
    : perfilPreparado && consulta.identidadId === identidadId && consulta.intento === intento
    ? consulta.estado
    : { tipo: "cargando" };

  const reintentar = useCallback(() => {
    if (perfilPreparado) setIntento((valor) => valor + 1);
    else reintentarProvisionPerfil();
  }, [perfilPreparado, reintentarProvisionPerfil]);
  return { estado, reintentar };
}
</file>

<file path="src/hooks/useProvisionPerfil.ts">
import { useCallback, useEffect, useState } from "react";
import { asegurarPerfilPropio, type ResultadoProvisionPerfil } from "@/services/provisionPerfilService";
import type { IdentidadSupabase } from "@/types/Auth";

export function useProvisionPerfil(identidad: IdentidadSupabase | null) {
  const identidadId = identidad?.id;
  const correoConfirmado = Boolean(identidad?.email_confirmed_at);
  const metadata = identidad?.user_metadata;
  const nombre = typeof metadata?.nombre === "string" ? metadata.nombre : null;
  const fechaNacimiento = typeof metadata?.fecha_nacimiento === "string" ? metadata.fecha_nacimiento : null;
  const [intento, setIntento] = useState(0);
  const [provision, setProvision] = useState<{
    identidadId: string;
    intento: number;
    resultado: ResultadoProvisionPerfil;
  } | null>(null);

  useEffect(() => {
    if (!identidadId) return;
    let vigente = true;

    async function preparar(id: string) {
      let resultado: ResultadoProvisionPerfil;
      try {
        resultado = await asegurarPerfilPropio({ identidadId: id, correoConfirmado, nombre, fechaNacimiento });
      } catch {
        resultado = { exito: false, codigo: "red", error: "No pudimos preparar tu perfil. Inténtalo otra vez." };
      }
      if (vigente) setProvision({ identidadId: id, intento, resultado });
    }

    // Fuera de onAuthStateChange: el transporte usa getSession del SDK.
    void preparar(identidadId);
    return () => { vigente = false; };
  }, [identidadId, correoConfirmado, nombre, fechaNacimiento, intento]);

  // Descartar el estado de la sesión anterior al salir o cambiar de cuenta.
  if (provision && provision.identidadId !== identidadId) setProvision(null);

  const resultado = provision && provision.identidadId === identidadId && provision.intento === intento
    ? provision.resultado
    : null;
  const reintentar = useCallback(() => setIntento((valor) => valor + 1), []);
  return { resultado, reintentar };
}
</file>

<file path="src/lib/supabase.ts">
import "react-native-url-polyfill/auto";
import AsyncStorage from "@react-native-async-storage/async-storage";
import { createClient, type SupabaseClient } from "@supabase/supabase-js";
import { AppState, Platform, type AppStateStatus } from "react-native";

let cliente: SupabaseClient | undefined;

/** Permite preparar el SDK antes de configurar el proyecto de pruebas o TI2. */
export function estaSupabaseConfigurado(): boolean {
  return Boolean(
    process.env.EXPO_PUBLIC_SUPABASE_URL?.trim() &&
      process.env.EXPO_PUBLIC_SUPABASE_KEY?.trim(),
  );
}

/** M4-A02: una sola instancia compartida por todos los servicios de la app. */
export function getSupabaseClient(): SupabaseClient {
  if (cliente) return cliente;

  // Expo necesita referencias estáticas con process.env.NOMBRE para incluirlas.
  const url = process.env.EXPO_PUBLIC_SUPABASE_URL?.trim();
  const clave = process.env.EXPO_PUBLIC_SUPABASE_KEY?.trim();

  if (!url || !clave) {
    throw new Error(
      "Configura EXPO_PUBLIC_SUPABASE_URL y EXPO_PUBLIC_SUPABASE_KEY en .env.local.",
    );
  }

  let protocolo: string;
  try {
    protocolo = new URL(url).protocol;
  } catch {
    throw new Error("EXPO_PUBLIC_SUPABASE_URL debe ser una URL válida.");
  }
  if (protocolo !== "https:" && protocolo !== "http:") {
    throw new Error("EXPO_PUBLIC_SUPABASE_URL debe usar HTTP o HTTPS.");
  }
  if (!clave.startsWith("sb_publishable_")) {
    throw new Error(
      "Usa la clave publishable de Supabase (sb_publishable_). Las claves secretas no pertenecen a la app móvil.",
    );
  }

  cliente = createClient(url, clave, {
    auth: {
      ...(Platform.OS !== "web" ? { storage: AsyncStorage } : {}),
      autoRefreshToken: true,
      persistSession: true,
      detectSessionInUrl: false,
      // /auth/callback procesa explícitamente los tokens del enlace de registro.
      flowType: "implicit",
    },
  });

  return cliente;
}

/**
 * En móvil, renueva tokens mientras la app está activa y libera la suscripción
 * al desmontar el layout. El SDK administra este ciclo automáticamente en web.
 * Esto prepara la persistencia del SDK; la restauración de la UI es M4-A06.
 */
export function iniciarCicloSesionSupabase(): () => void {
  if (!estaSupabaseConfigurado()) return () => {};

  const supabase = getSupabaseClient();
  if (Platform.OS === "web") return () => {};

  const sincronizar = (estado: AppStateStatus | null) => {
    if (estado === "active") {
      supabase.auth.startAutoRefresh();
    } else {
      supabase.auth.stopAutoRefresh();
    }
  };

  sincronizar(AppState.currentState);
  const suscripcion = AppState.addEventListener("change", sincronizar);

  return () => {
    suscripcion.remove();
    supabase.auth.stopAutoRefresh();
  };
}
</file>


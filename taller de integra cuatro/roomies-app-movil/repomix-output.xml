function volver() {
  if (router.canGoBack()) {
    router.back();
  } else {
    router.replace("/(tabs)/mensajes");
  }
}

export default function EncabezadoConvivencia({ integrantes }: Props) {
  const insets = useSafeAreaInsets();

  return (
    <View style={[styles.encabezado, { paddingTop: insets.top + 12 }]}>
      <Pressable
        onPress={volver}
        hitSlop={10}
        accessibilityRole="button"

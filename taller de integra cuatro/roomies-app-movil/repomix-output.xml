<file path="src/services/authService.ts">
import { isAuthError, isAuthRetryableFetchError } from "@supabase/supabase-js";
import { getSupabaseClient } from "@/lib/supabase";
import type {
  DatosRegistro,
  ResultadoCierreSesion,
  ResultadoConfirmacion,
  ResultadoInicioSesion,
  ResultadoRegistro,
} from "@/types/Auth";
import { REQUISITOS_CONTRASENA, validarContrasena } from "@/utils/contrasena";
import { validarFechaNacimiento } from "@/utils/fechaNacimiento";

function mensajeErrorSesion(error: unknown, accion: "entrar" | "salir"): string {
  if (isAuthError(error)) {
    switch (error.code) {
      case "invalid_credentials":
      case "user_not_found":
        return "El correo o la contraseña no son correctos.";
      case "email_not_confirmed":
        return "Confirma tu correo antes de iniciar sesión. Revisa el mensaje de confirmación que recibiste.";
      case "email_address_invalid":
      case "validation_failed":
        return "Revisa el correo y los datos que ingresaste.";
      case "over_request_rate_limit":
        return "Se alcanzó el límite de intentos. Espera un momento y vuelve a intentarlo.";
      case "email_provider_disabled":
      case "provider_disabled":
        return "El acceso por correo no está disponible en este momento.";
      case "user_banned":
        return "No se puede iniciar sesión con esta cuenta.";
    }
  }
  if (isAuthRetryableFetchError(error) || error instanceof TypeError) {
    return "No pudimos comunicarnos con el servicio. Revisa tu conexión e inténtalo otra vez.";
  }
  return accion === "entrar"
    ? "No pudimos iniciar sesión. Inténtalo nuevamente."
    : "No pudimos confirmar el cierre de sesión. Inténtalo nuevamente.";
}

/** M4-A05: el proveedor valida las credenciales, sin consultar usuarios de prueba. */
export async function iniciarSesionSupabase(
  email: string,
  password: string,
): Promise<ResultadoInicioSesion> {
  if (!email.trim() || !password) {
    return { exito: false, error: "Ingresa tu correo y contraseña." };
  }
  try {
    const { data, error } = await getSupabaseClient().auth.signInWithPassword({
      email: email.trim().toLowerCase(),
      // No recortar ni exigir la política del registro a contraseñas existentes.
      password,
    });
    if (error) return { exito: false, error: mensajeErrorSesion(error, "entrar") };
    if (!data.session) {
      return { exito: false, error: "El servicio no entregó una sesión válida. Vuelve a intentarlo." };
    }
    return { exito: true, sesion: data.session };
  } catch (error) {
    return { exito: false, error: mensajeErrorSesion(error, "entrar") };
  }
}

/** M4-A05: cerrar la sesión actual, conservando las de otros dispositivos. */
export async function cerrarSesionSupabase(): Promise<ResultadoCierreSesion> {
  try {
    const supabase = getSupabaseClient();
    const { error } = await supabase.auth.signOut({ scope: "local" });
    if (!error) return { exito: true };

    // El SDK puede haber retirado los tokens locales pese a fallar la petición.
    // Consultarlo evita mantener la UI autenticada cuando ya no existe sesión.
    const { data, error: errorSesion } = await supabase.auth.getSession();
    return {
      exito: false,
      error: mensajeErrorSesion(error, "salir"),
      sesionLocalCerrada: !errorSesion && data.session === null,
    };
  } catch (error) {
    return {
      exito: false,
      error: mensajeErrorSesion(error, "salir"),
      sesionLocalCerrada: false,
    };
  }
}

/** Solo traduce errores conocidos; evita mostrar detalles internos del servidor. */
function mensajeErrorRegistro(error: unknown): string {
  if (isAuthError(error)) {
    if (error.message.includes("ROOMIES_EDAD_MINIMA")) {
      return "Debes tener al menos 18 años para crear una cuenta.";
    }
    if (error.message.includes("ROOMIES_FECHA_NACIMIENTO_INVALIDA")) {
      return "Revisa tu fecha de nacimiento: debe ser una fecha válida y no futura.";
    }

    switch (error.code) {
      case "weak_password":
        return `La contraseña no cumple la política del servicio. ${REQUISITOS_CONTRASENA} Si ya cumple esas condiciones, prueba con una contraseña más larga y difícil de adivinar.`;
      case "email_address_invalid":
      case "validation_failed":
        return "Revisa el correo y los datos del registro.";
      case "email_address_not_authorized":
        return "El servicio de correo de este entorno solo permite direcciones autorizadas por el equipo. Usa una de ellas o configura el envío de correos.";
      case "over_email_send_rate_limit":
      case "over_request_rate_limit":
        return "Se alcanzó el límite de intentos o de correos. Espera un momento antes de volver a intentarlo.";
      case "email_exists":
      case "user_already_exists":
        return "No se pudo completar el registro con esos datos. Si ya tienes cuenta, inicia sesión.";
      case "signup_disabled":
      case "email_provider_disabled":
        return "El registro por correo no está habilitado en este momento.";
    }
  }

  if (isAuthRetryableFetchError(error) || error instanceof TypeError) {
    return "No pudimos comunicarnos con el servicio. Revisa tu conexión e inténtalo otra vez.";
  }

  return "No pudimos completar el registro. Inténtalo nuevamente; si persiste, revisa la configuración del servicio.";
}

/** M4-A04: registra una identidad; el perfil Roomies se obtendrá desde TI2. */
export async function registrarCuentaSupabase(
  datos: DatosRegistro,
  emailRedirectTo: string,
): Promise<ResultadoRegistro> {
  if (!datos.nombre.trim() || !datos.email.trim()) {
    return { exito: false, error: "Completa todos los campos." };
  }

  const fecha = /^(\d{4})-(\d{2})-(\d{2})$/.exec(datos.fechaNacimiento);
  const validacionFecha = validarFechaNacimiento(
    fecha ? `${fecha[3]}/${fecha[2]}/${fecha[1]}` : "",
  );
  if (!validacionFecha.valido) {
    return { exito: false, error: validacionFecha.error };
  }
  const errorPassword = validarContrasena(datos.password);
  if (errorPassword) return { exito: false, error: errorPassword };

  try {
    const { data, error } = await getSupabaseClient().auth.signUp({
      email: datos.email.trim().toLowerCase(),
      password: datos.password,
      options: {
        emailRedirectTo,
        data: {
          nombre: datos.nombre.trim(),
          fecha_nacimiento: validacionFecha.fechaISO,
        },
      },
    });

    if (error) return { exito: false, error: mensajeErrorRegistro(error) };
    if (data.session) {
      return { exito: true, estado: "sesion_iniciada", sesion: data.session };
    }
    if (!data.user) {
      return { exito: false, error: "El servicio no entregó un resultado de registro. Vuelve a intentarlo." };
    }

    // Supabase puede ocultar si ya existe la cuenta. No asegurar que se creó
    // una nueva ni que llegó un correo solo porque signUp no devolvió error.
    return { exito: true, estado: "confirmacion_pendiente" };
  } catch (error) {
    return { exito: false, error: mensajeErrorRegistro(error) };
  }
}

/** Procesa el enlace de confirmación del flujo implícito configurado en el SDK. */
export async function confirmarRegistroSupabase(enlace: string): Promise<ResultadoConfirmacion> {
  try {
    const url = new URL(enlace);
    const parametros = new URLSearchParams(url.hash.slice(1));
    const errorEnlace = parametros.get("error") ?? url.searchParams.get("error");
    if (errorEnlace) {
      return { exito: false, error: "El enlace de confirmación venció o ya fue utilizado. Intenta iniciar sesión si ya confirmaste tu correo." };
    }

    const tipo = parametros.get("type");
    const accessToken = parametros.get("access_token");
    const refreshToken = parametros.get("refresh_token");
    if (!accessToken || !refreshToken || tipo !== "signup") {
      return { exito: false, error: "Este enlace no contiene una confirmación de registro válida. Abre el enlace completo que recibiste por correo." };
    }

    const supabase = getSupabaseClient();
    // Verificar el usuario con el proveedor antes de guardar los tokens.
    const { data: identidad, error: errorIdentidad } = await supabase.auth.getUser(accessToken);
    if (errorIdentidad || !identidad.user?.email_confirmed_at) {
      return { exito: false, error: "No pudimos verificar la confirmación. Intenta iniciar sesión si ya confirmaste tu correo." };
    }
    const { data, error } = await supabase.auth.setSession({
      access_token: accessToken,
      refresh_token: refreshToken,
    });
    if (error || !data.session) {
      return { exito: false, error: "Tu correo puede estar confirmado, pero no pudimos iniciar la sesión. Intenta iniciar sesión de nuevo." };
    }
    return { exito: true, sesion: data.session };
  } catch {
    return { exito: false, error: "No pudimos procesar la confirmación. Revisa tu conexión y abre otra vez el enlace del correo." };
  }
}
</file>

<file path="src/services/httpClient.ts">
import { estaSupabaseConfigurado, getSupabaseClient } from "@/lib/supabase";
import type { CodigoErrorHttp, ErrorHttp, OpcionesFormularioHttp, OpcionesPeticionHttp, ResultadoHttp } from "@/types/Http";

function fallo(codigo: CodigoErrorHttp, error: string, estadoHttp?: number): ErrorHttp {
  return { exito: false, codigo, error, ...(estadoHttp === undefined ? {} : { estadoHttp }) };
}

function falloRespuesta(estadoHttp: number): ErrorHttp {
  if (estadoHttp === 401) {
    return fallo("no_autorizado", "El servicio no aceptó tu sesión.", estadoHttp);
  }
  if (estadoHttp === 403) {
    return fallo("sin_permiso", "No tienes permiso para realizar esta acción.", estadoHttp);
  }
  const mensaje = estadoHttp === 404
    ? "No se encontró el recurso solicitado."
    : estadoHttp === 400 || estadoHttp === 422
      ? "Revisa los datos que enviaste."
      : estadoHttp === 429
        ? "Se alcanzó el límite de solicitudes. Espera un momento e inténtalo otra vez."
        : "No pudimos completar la solicitud. Inténtalo más tarde.";
  // No propagar cuerpos de error que puedan contener datos internos o sensibles.
  return fallo("http", mensaje, estadoHttp);
}

/**
 * M4-A07: peticiones JSON a TI2. El SDK administra los tokens;
 * este módulo los obtiene para cada petición, sin guardarlos ni registrarlos.
 * Los adaptadores de cada recurso deben validar la forma de `datos` (unknown).
 */
export async function solicitarJson(
  ruta: string,
  opciones: OpcionesPeticionHttp = {},
): Promise<ResultadoHttp> {
  return solicitar(ruta, opciones, "json");
}

/** Envía FormData sin serializar ni fijar Content-Type; espera una respuesta JSON. */
export async function solicitarFormulario(
  ruta: string,
  opciones: OpcionesFormularioHttp,
): Promise<ResultadoHttp> {
  return solicitar(ruta, { ...opciones, metodo: opciones.metodo ?? "POST" }, "formulario");
  
}

function esFormulario(cuerpo: unknown): cuerpo is FormData {
  return typeof FormData !== "undefined" && cuerpo instanceof FormData;
}

/** Un único transporte mantiene las mismas protecciones para JSON y multipart. */
async function solicitar(
  ruta: string,
  opciones: OpcionesPeticionHttp,
  formato: "json" | "formulario",
): Promise<ResultadoHttp> {
  let base: URL;
  try {
    // Referencia estática necesaria para que Expo incluya el valor por entorno.
    const configuracion = process.env.EXPO_PUBLIC_API_URL?.trim();
    if (!configuracion) throw new Error();
    base = new URL(configuracion);
    if (!["http:", "https:"].includes(base.protocol) || base.username || base.password || base.search || base.hash) {
      throw new Error();
    }
    base.pathname = `${base.pathname.replace(/\/+$/, "")}/`;
  } catch {
    return fallo("configuracion", "La conexión con el servicio todavía no está configurada correctamente.");
  }

  let url: URL;
  try {
    // Solo rutas de esta API: no aceptar URLs externas para enviarles el Bearer.
    if (!ruta.startsWith("/") || ruta.startsWith("//") || ruta.includes("\\")) throw new Error();
    const rutaRelativa = base.pathname.endsWith("/api/") && ruta.startsWith("/api/")
      ? ruta.slice("/api/".length)
      : ruta.slice(1);
    url = new URL(rutaRelativa, base);
    if (url.origin !== base.origin || !url.pathname.startsWith(base.pathname) || url.hash) throw new Error();
  } catch {
    return fallo("peticion_invalida", "La ruta de la solicitud no es válida.");
  }

  const metodo = opciones.metodo ?? "GET";
  if (!["GET", "POST", "PUT", "PATCH", "DELETE"].includes(metodo)) {
    return fallo("peticion_invalida", "El método de la solicitud no es válido.");
  }
  const tiempoLimiteMs = opciones.tiempoLimiteMs ?? 15000;
  if (!Number.isFinite(tiempoLimiteMs) || tiempoLimiteMs <= 0) {
    return fallo("peticion_invalida", "El tiempo de espera de la solicitud no es válido.");
  }

  let cuerpo: string | FormData | undefined;
  if (formato === "formulario") {
    if (metodo === "GET" || !esFormulario(opciones.cuerpo)) {
      return fallo("peticion_invalida", "El formulario de la solicitud no tiene un formato válido.");
    }
    cuerpo = opciones.cuerpo;
  } else if (opciones.cuerpo !== undefined) {
    if (metodo === "GET") return fallo("peticion_invalida", "Una consulta GET no admite cuerpo.");
    if (esFormulario(opciones.cuerpo)) {
      return fallo("peticion_invalida", "El formato de los datos no corresponde a esta solicitud.");
    }
    try {
      cuerpo = JSON.stringify(opciones.cuerpo);
      if (cuerpo === undefined) throw new Error();
    } catch {
      return fallo("peticion_invalida", "Los datos de la solicitud no tienen un formato válido.");
    }
  }

  const headers: Record<string, string> = { Accept: "application/json" };
  if (formato === "json" && cuerpo !== undefined) headers["Content-Type"] = "application/json";
  if (opciones.autenticada !== false) {
    if (!estaSupabaseConfigurado()) {
      return fallo("configuracion", "La autenticación todavía no está configurada correctamente.");
    }
    try {
      const { data, error } = await getSupabaseClient().auth.getSession();
      if (error) return fallo("sesion_no_disponible", "No pudimos comprobar tu sesión. Inténtalo otra vez.");
      const token = data.session?.access_token;
      if (!token) return fallo("sin_sesion", "Inicia sesión para continuar.");
      if (opciones.identidadEsperada !== undefined && data.session?.user?.id !== opciones.identidadEsperada) {
        return fallo("sesion_no_disponible", "La cuenta cambió antes de completar la solicitud. Inténtalo otra vez.");
      }
      headers.Authorization = `Bearer ${token}`;
    } catch {
      return fallo("sesion_no_disponible", "No pudimos comprobar tu sesión. Inténtalo otra vez.");
    }
  }

  const controlador = new AbortController();
  const temporizador = setTimeout(() => controlador.abort(), tiempoLimiteMs);
  try {
    const respuesta = await fetch(url.href, {
      method: metodo,
      headers,
      body: cuerpo,
      signal: controlador.signal,
      credentials: "omit",
    });
    if (!respuesta.ok) return falloRespuesta(respuesta.status);
    if (respuesta.status === 204) return { exito: true, datos: null, estadoHttp: 204 };
    try {
      const datos: unknown = await respuesta.json();
      return { exito: true, datos, estadoHttp: respuesta.status };
    } catch {
      if (controlador.signal.aborted) return fallo("tiempo_agotado", "El servicio tardó demasiado en responder. Inténtalo otra vez.");
      return fallo("respuesta_invalida", "El servicio devolvió una respuesta que no pudimos interpretar.", respuesta.status);
    }
  } catch {
    return controlador.signal.aborted
      ? fallo("tiempo_agotado", "El servicio tardó demasiado en responder. Inténtalo otra vez.")
      : fallo("red", "No pudimos conectar con el servicio. Revisa tu conexión e inténtalo otra vez.");
  } finally {
    clearTimeout(temporizador);
  }
}

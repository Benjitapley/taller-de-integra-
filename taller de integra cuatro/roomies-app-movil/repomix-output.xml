import React, { useState } from "react";
import { View, TextInput, Text, StyleSheet, TouchableOpacity, TextInputProps } from "react-native";
import { Ionicons } from "@expo/vector-icons";
import { colors } from "../theme/colors";

interface CustomInputProps extends TextInputProps {
  etiqueta: string;
  icono: keyof typeof Ionicons.glyphMap;
  esContrasena?: boolean;
  error?: string;
  ayuda?: string;
  mostrarIconoInterior?: boolean;
  iconoDerecho?: keyof typeof Ionicons.glyphMap;
  multilinea?: boolean;
}

export const CustomInput: React.FC<CustomInputProps> = ({
  etiqueta,
  icono,
  esContrasena = false,
  error,
  ayuda,
  mostrarIconoInterior = true,
  iconoDerecho,
  multilinea = false,
  ...rest
}) => {
  const [mostrarContrasena, setMostrarContrasena] = useState(false);

  const iconoDerechoVisible =
    esContrasena
      ? mostrarContrasena
        ? "eye-off-outline"
        : "eye-outline"
      : iconoDerecho;

  return (
    <View style={styles.contenedor}>
      <View style={styles.filaEtiqueta}>
        <Ionicons name={icono} size={16} color={colors.primary} />
        <Text style={styles.etiqueta}>{etiqueta}</Text>
      </View>

      <View style={[styles.inputWrapper,multilinea && styles.inputWrapperMultilinea, error && styles.inputWrapperError]}>
        {mostrarIconoInterior && (
          <Ionicons
            name={icono}
            size={18}
            color={colors.border}
            style={styles.icono}
          />
        )}

        <TextInput
          style={[styles.input, multilinea && styles.inputMultilinea]}
          multiline={multilinea}
          placeholderTextColor="#9CA3AF"
          secureTextEntry={esContrasena && !mostrarContrasena}
          {...rest}
        />

        {iconoDerechoVisible && (
          <TouchableOpacity
            onPress={
              esContrasena
                ? () => setMostrarContrasena(!mostrarContrasena)
                : undefined
            }
            disabled={!esContrasena}
            hitSlop={8}
          >
            <Ionicons
              name={iconoDerechoVisible}
              size={21}
              color={colors.border}
            />
          </TouchableOpacity>
        )}
      </View>

      {error ? (
        <Text accessibilityRole="alert" style={styles.textoError}>{error}</Text>
      ) : ayuda ? (
        <Text style={styles.textoAyuda}>{ayuda}</Text>
      ) : null}
    </View>
  );
};

const styles = StyleSheet.create({
  contenedor: {
    marginBottom: 16,
    width: "100%",
  },

      >
        <Ionicons name="chevron-back" size={26} color="#4F46E5" />
      </Pressable>
      <View style={styles.avataresGrupo}>
        {integrantes.map((integrante, indice) => (
          <Image
            key={integrante.id}
            source={{ uri: integrante.fotoUrl }}
            style={[styles.avatarGrupo, { marginLeft: indice === 0 ? 0 : -10 }]}
          />

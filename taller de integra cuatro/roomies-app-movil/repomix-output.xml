  TouchableOpacity,
  TextInputProps,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";
import { colors } from "../theme/colors";

interface CustomInputProps extends TextInputProps {
  etiqueta: string;
  icono: keyof typeof Ionicons.glyphMap;
  esContrasena?: boolean;
  error?: string;
  mostrarIconoInterior?: boolean;
  iconoDerecho?: keyof typeof Ionicons.glyphMap;
}

export const CustomInput: React.FC<CustomInputProps> = ({
  etiqueta,
  icono,
  esContrasena = false,
  error,
  mostrarIconoInterior = true,
  iconoDerecho,
  ...rest
}) => {
  const [mostrarContrasena, setMostrarContrasena] = useState(false);

  const iconoDerechoVisible =
    esContrasena
      ? mostrarContrasena
        ? "eye-off-outline"
        : "eye-outline"
      : iconoDerecho;

  return (
    <View style={styles.contenedor}>
      <View style={styles.filaEtiqueta}>
        <Ionicons name={icono} size={16} color={colors.primary} />
        <Text style={styles.etiqueta}>{etiqueta}</Text>
      </View>

      <View style={[styles.inputWrapper, error && styles.inputWrapperError]}>
        {mostrarIconoInterior && (
          <Ionicons
            name={icono}
            size={18}
            color={colors.border}
            style={styles.icono}
          />
        )}

        <TextInput
          style={styles.input}
          placeholderTextColor="#9CA3AF"
          secureTextEntry={esContrasena && !mostrarContrasena}
          {...rest}
        />

        {iconoDerechoVisible && (
          <TouchableOpacity
            onPress={

# Copiar a .env.local (ignorado por Git) y completar con el proyecto elegido.
# Get connected o Settings > API Keys en Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# URL base de FastAPI/Gateway que confirme TI2 (distinta de la URL de Supabase).
# Usar el origen del Gateway, sin /api al final. Sin contraseñas ni claves.
# Gateway de TI2 en Render (informado el 18/11): https://roomies-main-api-gateway.onrender.com
EXPO_PUBLIC_API_URL=

# render: despliegue actual con el alta en /local/v1/perfil/inicializacion.
# Vacío: conserva la consulta previa sin activar el alta.
EXPO_PUBLIC_CONTRATO_PERFIL=

# Solo desarrollo: "1" muestra el dashboard de convivencia con datos de muestra (Sprint 2).
# Dejar vacía en cualquier candidato o demostración con la API real (M4S3-D01).
EXPO_PUBLIC_CONVIVENCIA_DEMO=

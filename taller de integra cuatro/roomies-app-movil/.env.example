# Copiar a .env.local (ignorado por Git) y completar con el proyecto elegido.
# Get connected o Settings > API Keys en Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# URL base de FastAPI/Gateway que confirme TI2 (distinta de la URL de Supabase).
# Mantener vacía hasta contar con un entorno confirmado. Sin contraseñas ni claves.
EXPO_PUBLIC_API_URL=

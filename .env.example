# ==========================================
# Roomies - Variables de Entorno
# ==========================================
# Copia este archivo como .env y rellena con tus valores reales.
# NUNCA subas el archivo .env al repositorio.

# Supabase
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_KEY=tu_service_key_aqui
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# JWT (Autenticación con tokens)
# Genera una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=genera_tu_clave_secreta_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# SMTP (Verificación por correo)
# Para Gmail: usa una Contraseña de Aplicación (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion

# Cifrado de datos sensibles (Fernet)
# Genera una clave con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=genera_tu_clave_fernet_aqui

# Minutos de validez del código de verificación
CODIGO_EXPIRACION_MINUTOS=15

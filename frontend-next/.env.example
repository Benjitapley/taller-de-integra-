# Origen exclusivo del servidor Next.js. No incluir credenciales ni prefijo NEXT_PUBLIC_.
FASTAPI_ORIGIN=http://127.0.0.1:8000

# Desactivado: no habilitar hasta preparar un entorno de pruebas aislado.
WEB_AUTH_ENABLED=false
# Origen público exacto para validar CSRF. HTTPS obligatorio con NODE_ENV=production.
WEB_AUTH_ORIGIN=http://127.0.0.1:3000
# Independiente de rewrites: configuración explícita del transporte JWT servidor-servidor.
WEB_AUTH_FASTAPI_ORIGIN=http://127.0.0.1:8000

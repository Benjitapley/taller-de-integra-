# Origen exclusivo del servidor Next.js. No incluir credenciales ni prefijo NEXT_PUBLIC_.
FASTAPI_ORIGIN=http://127.0.0.1:8000

# Desactivado: no habilitar hasta preparar un entorno de pruebas aislado.
WEB_AUTH_ENABLED=false
# Origen público exacto para validar CSRF. HTTPS obligatorio con NODE_ENV=production.
WEB_AUTH_ORIGIN=http://127.0.0.1:3000
# Independiente de rewrites: configuración explícita del transporte JWT servidor-servidor.
WEB_AUTH_FASTAPI_ORIGIN=http://127.0.0.1:8000

# Alternativa Supabase real: activar después del SQL/roles/cuentas aprobados.
# WEB_AUTH_ENABLED=true
# WEB_AUTH_PROVIDER=supabase
# ROOMIES_RUNTIME_MODE=supabase
# ROOMIES_LOCAL_MODE=0
# ROOMIES_SUPABASE_PROJECT_REF=erefnpvdjondjpcyjrpb
# WEB_SUPABASE_ORIGIN=https://erefnpvdjondjpcyjrpb.supabase.co
# WEB_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# WEB_AUTH_RECOVERY_SECRET=REPLACE_WITH_EXCLUSIVE_RANDOM_SERVER_SECRET_AT_LEAST_32_CHARACTERS
# Callback a añadir sin quitar URLs móviles:
# http://127.0.0.1:3000/web-api/auth/confirmar

            },
            "description": "Parte de la ubicación"
          },
          {
            "name": "personas",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "1",
                    "2",
                    "3"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "1, 2 o 3 (tres o más personas)",
              "title": "Personas"
            },
            "description": "1, 2 o 3 (tres o más personas)"
          },
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "casa",
                    "departamento",
                    "habitacion"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tipo de vivienda",
              "title": "Tipo"
            },
            "description": "Tipo de vivienda"
          },
          {
            "name": "mascotas",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "si",
                    "no"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mascotas"
            }
          },
          {
            "name": "precio_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.0
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Precio Min"
            }
          },
          {
            "name": "precio_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.0
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Precio Max"
            }
          },
          {
            "name": "categoria",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "busco",
                    "ofrezco"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Categoria"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 100,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Máximo de resultados; omitir para listar todos",
              "title": "Limite"
            },
            "description": "Máximo de resultados; omitir para listar todos"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 9223372036854775807,
              "minimum": 0,
              "description": "Resultados a omitir para paginar",
              "default": 0,
              "title": "Offset"
            },
            "description": "Resultados a omitir para paginar"
          }
        ],
        "responses": {

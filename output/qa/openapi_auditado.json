    "/api/publicaciones/buscar": {
      "get": {
        "tags": [
          "Publicaciones"
        ],
        "summary": "Buscar arriendos con filtros",
        "operationId": "obtener_publicaciones_api_publicaciones_buscar_get",
        "parameters": [
          {
            "name": "consulta",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 250
                },
                {
                  "type": "null"
                }
              ],

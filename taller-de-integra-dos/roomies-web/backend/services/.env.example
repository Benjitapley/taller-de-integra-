# Copiar como .env.roomies (ignorado por Git). No usar la contraseña postgres del proyecto.
# Habilitar solo después de aprobar SQL aditivo, respaldo y contraseñas por servicio.
ROOMIES_RUNTIME_MODE=supabase
ROOMIES_LOCAL_MODE=0
ROOMIES_PERSISTENCE_LAYOUT=haycupo-v1
ROOMIES_SUPABASE_PROJECT_REF=erefnpvdjondjpcyjrpb
ROOMIES_SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
ROOMIES_AUTH_PROVIDER_URL=https://${ROOMIES_SUPABASE_PROJECT_REF}.supabase.co
ROOMIES_AUTH_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
AUTH_USERS_UPSTREAM_URL=http://127.0.0.1:8001
LISTADO_UPSTREAM_URL=http://127.0.0.1:8002
MATCH_UPSTREAM_URL=http://127.0.0.1:8003
SUPABASE_URL=${ROOMIES_AUTH_PROVIDER_URL}
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
# Contraseñas URL-encoded y CA descargada del Dashboard; ajustar ruta URL-encoded.
AUTH_USERS_DATABASE_URL=postgresql://sql_auth_users.${ROOMIES_SUPABASE_PROJECT_REF}:REPLACE_AUTH_PASSWORD@${ROOMIES_SUPABASE_DB_HOST}:6543/postgres?sslmode=verify-full&sslrootcert=C%3A%2Fpath%2Fproject-ca.crt
LISTADO_DATABASE_URL=postgresql://sql_listado_applications.${ROOMIES_SUPABASE_PROJECT_REF}:REPLACE_LISTADO_PASSWORD@${ROOMIES_SUPABASE_DB_HOST}:6543/postgres?sslmode=verify-full&sslrootcert=C%3A%2Fpath%2Fproject-ca.crt
MATCH_DATABASE_URL=postgresql://sql_match_conexion.${ROOMIES_SUPABASE_PROJECT_REF}:REPLACE_MATCH_PASSWORD@${ROOMIES_SUPABASE_DB_HOST}:6543/postgres?sslmode=verify-full&sslrootcert=C%3A%2Fpath%2Fproject-ca.crt
ROOMIES_INTERNAL_TOKEN=REPLACE_WITH_EXCLUSIVE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# UUID explícitos de administradores autorizados; vacío restringe el panel a todos.
ROOMIES_ADMIN_SUBJECTS=
# Directorio local persistente para fotos; no subir documentos privados aquí.
ROOMIES_IMAGE_DIR=C:/Users/gerla/taller-de-integra-/.roomies-images
